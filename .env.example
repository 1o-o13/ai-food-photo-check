# Vercel > Project > Settings > Environment Variables 에 넣을 값들
# 이 파일을 복사해 .env.local 로 만들고 로컬에서 테스트할 때 씁니다. (.env.local 은 GitHub에 올리지 마세요)

# 필수: Anthropic Console(console.anthropic.com)에서 발급한 API 키
ANTHROPIC_API_KEY=

# 선택: 사용할 모델 (기본값 claude-haiku-5-5, 저렴하고 빠름)
ANTHROPIC_MODEL=claude-haiku-5-5

# 선택: 1인당 하루 무료 진단 횟수 (기본 3)
DAILY_LIMIT=3

# 선택: 내 사이트 주소. 넣으면 다른 사이트에서 API를 호출하지 못함
ALLOWED_ORIGIN=https://내도메인.com

# 선택: 서버 쪽 횟수 제한 (Upstash Redis 무료 플랜)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
